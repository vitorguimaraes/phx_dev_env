# Postgres variables
# obs: these variables only take effect when the db_data volume is empty.
# Any pre-existing database will be left untouched on container startup.
# To recreate the database, run: docker compose down -v
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# MUST be the same name defined in database service name in docker-compose.yaml
POSTGRES_HOST=db_service
POSTGRES_DB=app_db
POSTGRES_PORT=5432
# host port to connect to the database (e.g. DBeaver), set by run.sh
DB_HOST_PORT=6032

# Phoenix project
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
SECRET_KEY_BASE=
POOL_SIZE=2
# Phoenix application port inside the container
APP_PORT=4000
# host port to open the application in the browser, set by run.sh
APP_HOST_PORT=4000

# Docker names used in docker-compose.yaml (set by run.sh from the project's name,
# so several projects can run at the same time)
APP_IMAGE_NAME=app_service
APP_CONTAINER_NAME=app_container
DB_CONTAINER_NAME=db_container

# Host user ids, used to run the app container as your user (set by run.sh)
HOST_UID=1000
HOST_GID=1000
