#!/bin/bash
# Validates the commit subject: <gitmoji> <type>(<scope>): <description>
export LC_ALL=C.UTF-8

# first line that is not a comment or blank
subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)

# commits generated by git itself
if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!|amend!)\  ]]; then
    exit 0
fi

# ignore the emoji variation selector (♻️ and ♻ are the same emoji)
subject=${subject//$'️'/}

declare -A emojis=(
    [feat]="✨" [fix]="🐛" [refactor]="♻" [perf]="⚡" [test]="✅" [docs]="📝"
    [style]="🎨" [build]="📦" [ci]="👷" [chore]="🔧" [revert]="⏪"
)

pattern='^([^ ]+) ([a-z]+)(\([a-z0-9_-]+\))?!?: [^ ].*$'

if [[ "$subject" =~ $pattern ]] &&
   [[ "${emojis[${BASH_REMATCH[2]}]}" == "${BASH_REMATCH[1]}" ]] &&
   (( ${#subject} <= 72 )); then
    exit 0
fi

cat >&2 <<'EOF'
Invalid commit message. Expected format (subject up to 72 characters):

  <gitmoji> <type>(<scope>): <description>

  ✨ feat    🐛 fix     ♻️ refactor  ⚡️ perf   ✅ test    📝 docs
  🎨 style   📦 build   👷 ci        🔧 chore  ⏪ revert

Example: ✨ feat(accounts): add password reset via email
EOF
printf "\nGot: %s\n" "$subject" >&2
exit 1
